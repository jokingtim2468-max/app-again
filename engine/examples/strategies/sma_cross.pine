//@version=5
strategy("SMA Cross", overlay=true, initial_capital=10000, default_qty_type=strategy.fixed, default_qty_value=1)

fastLen = input.int(10, "Fast length", minval=1)
slowLen = input.int(30, "Slow length", minval=1)

fast = ta.sma(close, fastLen)
slow = ta.sma(close, slowLen)
plot(fast, "Fast SMA", color=color.orange)
plot(slow, "Slow SMA", color=color.blue)

if ta.crossover(fast, slow)
    strategy.entry("Long", strategy.long)
if ta.crossunder(fast, slow)
    strategy.close("Long")
