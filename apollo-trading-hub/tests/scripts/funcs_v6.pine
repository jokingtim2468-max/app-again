//@version=6
strategy("v6 features")
f_band(src, len) =>
    basis = ta.sma(src, len)
    dev = 2 * ta.stdev(src, len)
    [basis + dev, basis - dev]
[up, dn] = f_band(close, 20)
mode = switch
    close > up => 1
    close < dn => -1
    => 0
var int streak = 0
streak := mode == 1 ? streak + 1 : 0
sumLast = 0.0
for i = 0 to 4
    sumLast += close[i] > open[i] ? 1 : 0
if mode == -1 and sumLast >= 3
    strategy.entry("rev", strategy.long)
if mode == 1 or streak > 5
    strategy.close_all()
bgcolor(mode == 1 ? color.new(color.red, 80) : na)
