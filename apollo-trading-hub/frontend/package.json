{
  "name": "apollo-trading-hub",
  "version": "1.0.0",
  "description": "Apollo Trading - modular prop fleet execution terminal",
  "main": "dist-electron/main.js",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && tsc -p electron/tsconfig.json",
    "electron:dev": "tsc -p electron/tsconfig.json && concurrently -k \"vite\" \"wait-on tcp:5173 && cross-env VITE_DEV=1 electron .\"",
    "dist:win": "npm run build && electron-builder --win nsis --publish never",
    "build:demo": "vite build --mode demo --outDir dist-demo",
    "release:win": "npm run build && electron-builder --win nsis --publish always"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "electron-updater": "^6.3.9",
    "lightweight-charts": "^5.0.9",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-grid-layout": "^1.5.4",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@types/react-grid-layout": "^1.3.5",
    "@vitejs/plugin-react": "^4.3.2",
    "concurrently": "^9.0.1",
    "cross-env": "^7.0.3",
    "electron": "^32.2.0",
    "electron-builder": "^25.1.8",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "com.apollotradinghub.app",
    "productName": "Apollo Trading",
    "files": [
      "dist/**",
      "dist-electron/**",
      "build/icon.png"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "artifactName": "Apollo-Trading-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "Apollo Trading",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "jokingtim2468-max",
        "repo": "app-again"
      }
    ],
    "extraResources": [
      {
        "from": "../backend",
        "to": "apollo/backend",
        "filter": [
          "**/*",
          "!state/**",
          "!**/__pycache__/**"
        ]
      },
      {
        "from": "../mcp-server",
        "to": "apollo/mcp-server",
        "filter": [
          "**/*",
          "!**/__pycache__/**"
        ]
      },
      {
        "from": "../strategies",
        "to": "apollo/strategies"
      },
      {
        "from": "../scripts",
        "to": "apollo/scripts",
        "filter": [
          "**/*",
          "!**/__pycache__/**"
        ]
      }
    ]
  },
  "author": "Apollo Trading",
  "productName": "Apollo Trading"
}